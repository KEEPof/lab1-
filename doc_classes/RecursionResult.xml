<?xml version="1.0" encoding="UTF-8" ?>
<class name="RecursionResult" inherits="RefCounted" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/godotengine/godot/master/doc/class.xsd">
	<brief_description>
		Результат вычисления рекурсивной функции.
	</brief_description>
	<description>
		Содержит результат вычисления, количество вызовов, время и потребление памяти.
	</description>
	<tutorials>
	</tutorials>
	<members>
		<member name="success" type="bool" setter="" getter="get_success" default="false">
			Успешность вычисления.
		</member>
		<member name="value" type="int" setter="" getter="get_value" default="0">
			Вычисленное значение.
		</member>
		<member name="calls" type="int" setter="" getter="get_calls" default="0">
			Количество вызовов рекурсии.
		</member>
		<member name="error" type="String" setter="" getter="get_error" default="&quot;&quot;">
			Сообщение об ошибке.
		</member>
		<member name="time" type="String" setter="" getter="get_time" default="&quot;&quot;">
			Время выполнения.
		</member>
		<member name="digits_output" type="String" setter="" getter="get_digits_output" default="&quot;&quot;">
			Вывод цифр для recursion3.
		</member>
		<member name="memory_amount" type="int" setter="" getter="get_memory_amount" default="0">
			Потребление памяти в байтах.
		</member>
	</members>
</class>
